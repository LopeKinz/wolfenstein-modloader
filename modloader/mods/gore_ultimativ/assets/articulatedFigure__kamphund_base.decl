ballAndSocketJoint "neck" {
	body1 "neck"
	body2 "chest"
	anchor joint( "neck" )
	shafts bonedir( "neck", "head" ), bonedir( "head", "neck" )
	minTwist 0.1000000015
	maxTwist 5
	friction 0.210
	coneLimit bonedir( "neck", "head" ), 40, bonedir( "neck", "head" )
	limitFudge 0
	syncConstraint 0
}

ballAndSocketJoint "head" {
	body1 "head"
	body2 "neck"
