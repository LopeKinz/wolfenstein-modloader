universalJoint "waist" {
	body1 "hips"
	body2 "abdomen"
	anchor joint( "hips" )
	shafts bonedir( "hips", "spine1" ), bonedir( "spine1", "hips" )
	minTwist 0.1000000015
	maxTwist 10
	friction 0.420
	coneLimit ( -0.0000000119, 0, 1 ), 19
	limitFudge 1
	syncConstraint 0
}

