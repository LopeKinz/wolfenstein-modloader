body "hips" {
	joint "hips"
	mod both
	model box( ( -12, -16, -8 ), ( 12, 16, 8 ) )
	origin ( -1.4221899509, 0, 70 )
	density 0.003
	linearFriction 0.075000003
	angularFriction 0.0500000007
	contactFriction 0.5
	contents corpse
	clipMask solid, ikclip
	selfCollision 0
	noSyncCollide 0
	clearClipMaskInSolid 0
	bouncyness 0.0500000007
	containedJoints "*origin -*spine -*leftupleg -*rightupleg -*neck"
}

