universalJoint "Abdomen_to_Torso" {
	body1 "Torso"
	body2 "Abdomen"
	anchor joint( "spine1" )
	shafts bonedir( "spine", "spine1" ), bonedir( "spine1", "spine" )
	friction 1.260
	coneLimit ( -0.0000000119, 0, 1 ), 17
	syncConstraint 0
}

hinge "Right_arm_upper_to_Torso" {
	body1 "Right_arm_upper"
	body2 "Torso"
	anchor joint( "rightarm" )
	axis ( 0.0000000119, -1, 0 )
	friction 0.210
	limit 35, 10, 0
	syncConstraint 0
}

hinge "Left_Arm_upper_To_Torso" {
	body1 "left_arm_upper"
	body2 "Torso"
	anchor joint( "leftarm" )
	axis ( 0.0000000119, -1, 0 )
	friction 0.420
	syncConstraint 0
}

