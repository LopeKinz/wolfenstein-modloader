hinge "Left_thruster_to_Left_Wing" {
	body1 "Left_Thruster"
	body2 "Left_Wing"
	anchor joint( "left_thruster_y" )
	axis ( 1, 0, 0 )
	friction 0.294
	limit -27.5, 105, 0
	syncConstraint 0
}

hinge "Left_Wing_To_Body" {
	body1 "Left_Wing"
	body2 "body"
	anchor joint( "left_wing" )
	axis ( 0.0000000119, 0, 1 )
	friction 0.378
	limit 20, 70, 0
	syncConstraint 0
}

