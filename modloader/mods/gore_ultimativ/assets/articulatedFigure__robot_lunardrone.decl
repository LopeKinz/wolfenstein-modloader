{

settings {
	model "characters/drone/drone.md6"
	skin ""
	defaultBouncyness 0.3000000119
	defaultLinearFriction 0.0099999998
	defaultAngularFriction 0.0099999998
	defaultContactFriction 0.8000000119
	defaultConstraintFriction 0.5
	defaultGravityScale 0.2
	suspendSpeed 20, 30, 40, 60
	noMoveTime 1
	noMoveTranslation 10
	noMoveRotation 10
	minMoveTime -1
	maxMoveTime -1
	contents corpse
	clipMask solid, ikclip
	selfCollision 0
	solverConstants {
		errorReduction 0.5
		errorReductionMax 256
		lcpEpsilon 0.00001
		limitErrorReduction 0.3000000119
		limitErrorReductionMax 256
		limitLcpEpsilon 0.0001
		contactErrorReduction 0.200000003
		contactErrorReductionMax 256
		contactLcpEpsilon 0.000001
		universalErrorReduction 0.5
		universalErrorReductionMax 256
		universalTorsionLcpEpsilon 0.1000000015
	}
	syncSolverConstants {
		errorReduction 0.5
		errorReductionMax 512
		lcpEpsilon 0.001
		limitErrorReduction 0.1000000015
		limitErrorReductionMax 128
		limitLcpEpsilon 0.000001
		contactErrorReduction 0.200000003
		contactErrorReductionMax 256
		contactLcpEpsilon 0.000001
		universalErrorReduction 0.5
		universalErrorReductionMax 512
		universalTorsionLcpEpsilon 0.1000000015
	}
}

body "body" {
	joint "base"
	mod both
	model box( ( -20, -7.5, -9 ), ( 20, 7.5, 9 ) )
	origin joint( "base" )
	density 0.0500000007
	linearFriction 0.0099999998
	angularFriction 0.0099999998
	contactFriction 0.8000000119
	contents corpse
	clipMask solid, ikclip
	selfCollision 0
	noSyncCollide 0
	clearClipMaskInSolid 0
	bouncyness 0.400000006
	containedJoints "*base -*left_wing -*right_wing -*gun_x_axis -*left_side_feeler -*right_side_feeler"
}

body "Left_Thruster" {
