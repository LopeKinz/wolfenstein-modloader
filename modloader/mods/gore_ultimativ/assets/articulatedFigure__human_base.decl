{

settings {
	model "characters/standard/base.md6"
	skin ""
	clipMaterial "surfaceonly/flesh"
	defaultBouncyness 0.200000003
	defaultlinearFriction 0.3
	defaultangularFriction 0.4
	defaultcontactFriction 0.7
	defaultConstraintFriction 0.5
	defaultGravityScale 1
	suspendSpeed 20, 20, 40, 60
	noMoveTime 5
	noMoveTranslation 64
	noMoveRotation 5
	minMoveTime -1
	maxMoveTime 5
	contents corpse
	clipMask solid, ikclip
	selfCollision 1
	solverConstants {
		errorReduction 0.1000000015
		errorReductionMax 64
		lcpEpsilon 0.0001
		maxLcpEpsilon 0.0099999998
		limitErrorReduction 0.2000000015
		limitErrorReductionMax 32
		limitLcpEpsilon 0.01
		contactErrorReduction 0.1000000015
		contactErrorReductionMax 0.3000000119
		contactLcpEpsilon 0.0001
		universalErrorReduction 0.1000000015
		universalErrorReductionMax 16
		universalTorsionLcpEpsilon 0.1000000015
		minTwistErrorReduction 0.001
		maxTwistErrorReduction 0.5
	}
	syncSolverConstants {
		errorReduction 0.5
		errorReductionMax 512
		lcpEpsilon 0.0001
		maxLcpEpsilon 0.0099999998
		limitErrorReduction 0.2000000015
		limitErrorReductionMax 128
		limitLcpEpsilon 0.01
		contactErrorReduction 0.200000003
		contactErrorReductionMax 256
		contactLcpEpsilon 0.000001
		universalErrorReduction 0.5
		universalErrorReductionMax 512
		universalTorsionLcpEpsilon 0.5
		minTwistErrorReduction 0.001
		maxTwistErrorReduction 0.5
	}
}

body "hips" {
	joint "hips"
	mod both
	model box( ( -5, -7, -4 ), ( 5, 7, 4 ) )
	origin joint( "hips" )
	density 0.0020000001
	linearFriction 0.3
	angularFriction 0.4
	contactFriction 0.7
	contents corpse
	clipMask solid, ikclip
	selfCollision 1
	noSyncCollide 0
	clearClipMaskInSolid 0
	bouncyness 0.200000003
	containedJoints "origin hips"
}

