ballAndSocketJoint "waist" {
	body1 "hips"
	body2 "abdomen"
	anchor joint( "hips" )
	shafts bonedir( "spine", "spine1" ), bonedir( "spine", "hips" )
	minTwist 1
	maxTwist 10
	friction 0.294
	coneLimit bonedir( "spine", "spine1" ), 20, bonedir( "spine", "spine1" )
	limitFudge 0
	syncConstraint 0
}

ballAndSocketJoint "left_hip" {
	body1 "left_thigh"
	body2 "hips"
	anchor joint( "leftupleg" )
	shafts bonedir( "leftupleg", "leftleg" ), ( 0.0000000119, 0, 1 )
	minTwist 1
	maxTwist 90
	friction 0.210
	coneLimit ( 0.0791813731, 0.2328201979, -0.9692910314 ), 60, bonedir( "leftupleg", "leftleg" )
	limitFudge 0
	syncConstraint 0
}

